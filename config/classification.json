{
  "extends": "common.json",
  "task": "classification",
  "name": "classification",
  "iterations": 10000000,
  "batch_size": 256,
  "lr": 0.01,
  "save_interval": 10,
  "output_path": "log/perform.json",
  "simulator": {
    "num_option_range": [
      2,
      20
    ],
    "ability_mu_range": [-1.0, 1.0],
    "ability_sigma_range": [0.5, 2.0],
    "difficulty_mu_range": [-1.0, 1.0],
    "difficulty_sigma_range": [0.5, 2.0],
    "discrimination_min_range": [0.3, 1.0],
    "discrimination_max_range": [1.5, 3.0],
    "quality_upper_range": [0.1, 0.4]
  },
  "path": {
    "data": "data/classification"
  }
}
